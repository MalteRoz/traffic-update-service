# .funcignore - Controls what gets deployed to Azure Functions
# This is used when deploying from the root directory

# Version control
.git/
.gitignore

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# IDE
.vscode/
.idea/

# Project files
pyproject.toml
uv.lock
README.md

# Tests (optional - uncomment if you don't want tests deployed)
# tests/

# Local settings
*.local.settings.json

# Azurite (development storage)
**/__azurite_db*.json
**/__blobstorage__/
**/__queuestorage__/
**/AzuriteConfig

